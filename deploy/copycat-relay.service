[Unit]
Description=CopyCat relay server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=copycat
Group=copycat
ExecStart=/usr/local/bin/copycat-relay run --data-dir /var/lib/copycat-relay --listen 0.0.0.0:8443
Environment=RUST_LOG=info,quinn=warn

EnvironmentFile=/etc/copycat-relay.env
Restart=on-failure
RestartSec=3

AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes

StateDirectory=copycat-relay
StateDirectoryMode=0700
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
UMask=0077

ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources

LimitNOFILE=65536
MemoryMax=128M
TasksMax=512

[Install]
WantedBy=multi-user.target
